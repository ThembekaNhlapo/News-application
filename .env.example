# Copy this file to .env and fill in real values before running the project.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Set USE_SQLITE=True to run/test locally without MariaDB set up.
USE_SQLITE=False

DB_NAME=news_db
DB_USER=news_user
DB_PASSWORD=news_password
DB_HOST=127.0.0.1
DB_PORT=3306

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=news@example.com

INTERNAL_API_BASE_URL=http://127.0.0.1:8000
